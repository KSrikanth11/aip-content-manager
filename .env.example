# Local use: copy to .env and fill in. Never share or commit .env.
# In Claude Code on the web, put these in the cloud environment's variables instead.
#
# R2 → Manage API tokens → Create: "Object Read & Write",
# applied to the buckets aip-public AND aip-content (articles and drafts live in aip-content).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Defaults shown; change only if yours differ.
R2_PUBLIC_BUCKET=aip-public
R2_PRIVATE_BUCKET=aip-content
PUBLIC_URL=https://media.aiprojects4u.com
SITE_URL=https://aiprojects4u.com
